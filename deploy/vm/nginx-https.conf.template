# Shared production proxy for the initial static website and demo API.
limit_req_zone $binary_remote_addr zone=nasa_per_ip:1m rate=2r/s;
limit_req_zone $server_name zone=nasa_global:1m rate=10r/s;
limit_conn_zone $binary_remote_addr zone=nasa_connections:1m;

server {
    listen 80 default_server;
    server_name PUBLIC_IP;
    server_tokens off;
    location /.well-known/acme-challenge/ { root /var/www/acme; }
    location / { return 308 https://PUBLIC_IP$request_uri; }
}

server {
    listen 443 ssl default_server;
    server_name PUBLIC_IP;
    server_tokens off;
    ssl_certificate /etc/letsencrypt/live/PUBLIC_IP/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/PUBLIC_IP/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:1m;
    client_max_body_size 16k;
    client_body_timeout 10s;
    client_header_timeout 10s;
    send_timeout 15s;
    keepalive_timeout 15s;
    limit_conn nasa_connections 20;
    limit_req_status 429;
    access_log off;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    root /opt/nasa2026/current/web/out;
    index index.html;

    location = /version.json {
        expires -1;
        try_files $uri =404;
    }
    location /_next/static/ {
        try_files $uri @previous_assets;
    }
    location @previous_assets {
        root /opt/nasa2026/previous/web/out;
        try_files $uri =404;
    }

    location = /api/compare {
        limit_except POST { deny all; }
        limit_req zone=nasa_per_ip burst=5 nodelay;
        limit_req zone=nasa_global burst=10 nodelay;
        proxy_pass http://127.0.0.1:8000/compare;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_read_timeout 10s;
    }
    location = /api/health {
        limit_except GET { deny all; }
        limit_req zone=nasa_per_ip burst=5 nodelay;
        proxy_pass http://127.0.0.1:8000/health;
    }
    # No NASA download proxy, docs or administration endpoints in the public demo.
    location /api/ { return 404; }
    location ~ /\. { deny all; }
    location / {
        limit_except GET { deny all; }
        try_files $uri $uri/ =404;
    }
}
