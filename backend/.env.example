# Groq API key for the "Explain it simply" narration and the "Ask Cooper" assistant
# (https://console.groq.com/keys).
# Copy this file to backend/.env and paste your key. Never commit backend/.env.
GROQ_API_KEY=
# Optional: a different Groq model for narration and chat
# GROQ_MODEL=openai/gpt-oss-120b
# Optional: a different Whisper model for voice notes
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# Optional: models for the Jarvis chat, in order (each has its own per-minute quota)
# GROQ_CHAT_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
