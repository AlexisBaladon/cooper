# Groq API key for the "Explain it simply" narration and the "Ask Cooper" assistant
# (https://console.groq.com/keys).
# Copy this file to backend/.env and paste your key. Never commit backend/.env.
GROQ_API_KEY=
# Optional: a different Groq model for narration and chat
# GROQ_MODEL=openai/gpt-oss-120b
# Optional: a different Whisper model for voice notes
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# Optional: models for the Jarvis chat, in order (each has its own per-minute quota)
# GROQ_CHAT_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b

# Twilio WhatsApp (disabled until configured). Server only; never paste in frontend.
WHATSAPP_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_WEBHOOK_URL=https://agrocooper.earth/api/whatsapp/webhook
# Comma-separated testers, e.g. whatsapp:+59899123456. Empty denies everyone.
WHATSAPP_ALLOWED_SENDERS=
# Production: /var/lib/nasa2026/whatsapp.sqlite3 (outside release directory).
WHATSAPP_DB_PATH=data/whatsapp.sqlite3
# Opt in to the fixed analysis of the website's default Young sample (clearly labelled demo).
WHATSAPP_DEMO_ANALYSIS=false
