# Groq API key for the "Explain it simply" narration and the "Ask Cooper" assistant
# (https://console.groq.com/keys).
# Copy this file to backend/.env and paste your key. Never commit backend/.env.
GROQ_API_KEY=
# Optional: a different Groq model for narration and chat
# GROQ_MODEL=openai/gpt-oss-120b
# Optional: a different Whisper model for voice notes
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# Optional: models for the Jarvis chat, in order (each has its own per-minute quota)
# GROQ_CHAT_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
# ElevenLabs key for the spoken voice of "Explain it simply" and Jarvis (https://elevenlabs.io,
# permission: Text to Speech). Without it the browser's own voice is used.
ELEVENLABS_API_KEY=
# Optional: another voice or model
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# Optional: Jarvis's voice, one for every language or one per language (es, en, pt)
# ELEVENLABS_VOICE_JARVIS=nPczCjzI2devNBz1zQrb
# ELEVENLABS_VOICE_JARVIS_ES=
# ELEVENLABS_MODEL=eleven_flash_v2_5
